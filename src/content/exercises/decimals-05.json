{
  "title": "Practice: fractions, decimals and percentages",
  "intro": "Three ways to write the same amount.",
  "questions": [
    {
      "id": "d5-q1",
      "type": "match",
      "prompt": "Match each fraction to the equal percentage.",
      "left": [
        { "id": "l1", "text": "$\\frac{1}{2}$" },
        { "id": "l2", "text": "$\\frac{1}{4}$" },
        { "id": "l3", "text": "$\\frac{1}{5}$" },
        { "id": "l4", "text": "$\\frac{3}{4}$" },
        { "id": "l5", "text": "$\\frac{1}{10}$" }
      ],
      "right": [
        { "id": "r1", "text": "$50\\%$" },
        { "id": "r2", "text": "$25\\%$" },
        { "id": "r3", "text": "$20\\%$" },
        { "id": "r4", "text": "$75\\%$" },
        { "id": "r5", "text": "$10\\%$" }
      ],
      "solution": { "l1": "r1", "l2": "r2", "l3": "r3", "l4": "r4", "l5": "r5" },
      "explanation": "The ones to know by heart. Each fraction has an equivalent out of 100: $\\frac{1}{5} = \\frac{20}{100}$, and so on.",
      "difficulty": "foundation"
    },
    {
      "id": "d5-q2",
      "type": "fill-blank",
      "prompt": "Write each decimal as a percentage.",
      "text": "$0.43 =$ [[a]]%     $0.8 =$ [[b]]%     $0.05 =$ [[c]]%     $1.3 =$ [[d]]%",
      "blanks": [
        { "id": "a", "accept": ["43"], "size": 4 },
        { "id": "b", "accept": ["80"], "size": 4 },
        { "id": "c", "accept": ["5"], "size": 4 },
        { "id": "d", "accept": ["130"], "size": 4 }
      ],
      "hints": ["Multiply by 100 — move the point 2 places right."],
      "explanation": "$0.43 \\to 43\\%$, $0.80 \\to 80\\%$ (not $8\\%$!), $0.05 \\to 5\\%$, $1.30 \\to 130\\%$.",
      "difficulty": "foundation"
    },
    {
      "id": "d5-q3",
      "type": "fill-blank",
      "prompt": "Write each percentage as a decimal.",
      "text": "$62\\% =$ [[a]]     $7\\% =$ [[b]]     $40\\% =$ [[c]]     $12.5\\% =$ [[d]]",
      "blanks": [
        { "id": "a", "accept": ["0.62", ".62"], "size": 6 },
        { "id": "b", "accept": ["0.07", ".07"], "size": 6 },
        { "id": "c", "accept": ["0.4", "0.40", ".4"], "size": 6 },
        { "id": "d", "accept": ["0.125", ".125"], "size": 6 }
      ],
      "hints": ["Divide by 100 — move the point 2 places left."],
      "explanation": "$62 \\div 100 = 0.62$, $7 \\div 100 = 0.07$ (not $0.7$), $40 \\div 100 = 0.4$, $12.5 \\div 100 = 0.125$."
    },
    {
      "id": "d5-q4",
      "type": "numeric",
      "prompt": "Write $\\frac{7}{20}$ as a percentage.",
      "answer": 35,
      "unit": "%",
      "hints": ["$20 \\times 5 = 100$."],
      "explanation": "$\\frac{7}{20} = \\frac{35}{100} = 35\\%$."
    },
    {
      "id": "d5-q5",
      "type": "numeric",
      "prompt": "Write $\\frac{3}{8}$ as a decimal.",
      "answer": 0.375,
      "hints": ["$3 \\div 8$"],
      "explanation": "$3 \\div 8 = 0.375$ (so $\\frac{3}{8} = 37.5\\%$)."
    },
    {
      "id": "d5-q6",
      "type": "mcq",
      "prompt": "Write $45\\%$ as a fraction in its simplest form.",
      "options": [
        { "id": "a", "text": "$\\frac{9}{20}$" },
        { "id": "b", "text": "$\\frac{45}{100}$" },
        { "id": "c", "text": "$\\frac{4}{5}$" },
        { "id": "d", "text": "$\\frac{9}{10}$" }
      ],
      "answer": "a",
      "hints": ["Start with $\\frac{45}{100}$ and divide by the HCF."],
      "explanation": "$\\frac{45}{100}$: the HCF is 5, giving $\\frac{9}{20}$. $\\frac{45}{100}$ is right but not simplest."
    },
    {
      "id": "d5-q7",
      "type": "numeric",
      "prompt": "Write $0.36$ as a fraction in its simplest form.",
      "answer": "9/25",
      "hints": ["$0.36 = \\frac{36}{100}$", "Divide top and bottom by 4."],
      "explanation": "$\\frac{36}{100} = \\frac{9}{25}$."
    },
    {
      "id": "d5-q8",
      "type": "order",
      "prompt": "Put these in order, **smallest first**.",
      "items": [
        { "id": "a", "text": "$0.61$" },
        { "id": "b", "text": "$\\frac{5}{8}$" },
        { "id": "c", "text": "$58\\%$" },
        { "id": "d", "text": "$\\frac{3}{5}$" },
        { "id": "e", "text": "$0.065$" }
      ],
      "solution": ["e", "c", "d", "a", "b"],
      "hints": ["Change them all to percentages."],
      "explanation": "As percentages: $0.065 = 6.5\\%$, $58\\%$, $\\frac{3}{5} = 60\\%$, $0.61 = 61\\%$, $\\frac{5}{8} = 62.5\\%$."
    },
    {
      "id": "d5-q9",
      "type": "table",
      "prompt": "Complete the table.",
      "columns": ["Fraction", "Decimal", "Percentage"],
      "rows": [
        [{ "given": "$\\frac{2}{5}$" }, { "answer": "0.4" }, { "answer": "40", "accept": ["40%"] }],
        [{ "answer": "3/20" }, { "given": "$0.15$" }, { "answer": "15", "accept": ["15%"] }],
        [{ "answer": "9/10" }, { "answer": "0.9" }, { "given": "$90\\%$" }],
        [{ "given": "$1\\frac{1}{4}$" }, { "answer": "1.25" }, { "answer": "125", "accept": ["125%"] }]
      ],
      "explanation": "$\\frac{2}{5} = 0.4 = 40\\%$; $0.15 = \\frac{15}{100} = \\frac{3}{20}$; $90\\% = 0.9 = \\frac{9}{10}$; $1\\frac{1}{4} = 1.25 = 125\\%$.",
      "difficulty": "core"
    },
    {
      "id": "d5-q10",
      "type": "manipulable",
      "prompt": "Shade $\\frac{2}{5}$ of the hundred square.",
      "widget": "percent-grid",
      "config": { "start": { "p": 0 } },
      "target": { "p": 40 },
      "explanation": "$\\frac{2}{5} = \\frac{40}{100}$, so 40 squares.",
      "difficulty": "foundation"
    },
    {
      "id": "d5-q11",
      "type": "mcq",
      "prompt": "In class A, $\\frac{13}{20}$ of students walk to school. In class B, $62\\%$ walk. Which class has the higher proportion walking?",
      "options": [
        { "id": "a", "text": "Class A" },
        { "id": "b", "text": "Class B" },
        { "id": "c", "text": "They are the same" }
      ],
      "answer": "a",
      "shuffleOptions": false,
      "hints": ["Write $\\frac{13}{20}$ as a percentage."],
      "explanation": "$\\frac{13}{20} = \\frac{65}{100} = 65\\%$, which is more than $62\\%$.",
      "difficulty": "core"
    },
    {
      "id": "d5-q12",
      "type": "flashcards",
      "prompt": "Flip through these until you know them by heart.",
      "cards": [
        { "id": "c1", "front": "$\\frac{1}{2}$", "back": "$0.5 = 50\\%$" },
        { "id": "c2", "front": "$\\frac{1}{4}$", "back": "$0.25 = 25\\%$" },
        { "id": "c3", "front": "$\\frac{3}{4}$", "back": "$0.75 = 75\\%$" },
        { "id": "c4", "front": "$\\frac{1}{5}$", "back": "$0.2 = 20\\%$" },
        { "id": "c5", "front": "$\\frac{1}{10}$", "back": "$0.1 = 10\\%$" },
        { "id": "c6", "front": "$\\frac{1}{8}$", "back": "$0.125 = 12.5\\%$" },
        { "id": "c7", "front": "$\\frac{1}{3}$", "back": "$0.333\\ldots \\approx 33.3\\%$" },
        { "id": "c8", "front": "$\\frac{1}{100}$", "back": "$0.01 = 1\\%$" }
      ],
      "explanation": "Knowing these makes percentage questions much faster."
    }
  ]
}
