      "target": { "n": 10 },
      "tolerance": 0,
      "hints": ["Exterior angle $= 180 - 144 = 36^\\circ$.", "$360 \\div 36 = ?$"],
      "explanation": "Exterior $36^\\circ$, so $n = 360 \\div 36 = 10$ — a regular decagon."
