    {
      "id": "y1-q10",
      "type": "steps",
      "prompt": "Use ratio and the angle sum.",
      "scenario": "The six interior angles of a hexagon are in the ratio $4 : 5 : 6 : 6 : 7 : 8$. Find the largest angle.",
      "steps": [
        { "kind": "numeric", "prompt": "What is the total of the angles in a hexagon?", "answer": 720, "unit": "°" },
        { "kind": "numeric", "prompt": "How many parts are there in the ratio?", "answer": 36 },
        { "kind": "numeric", "prompt": "How many degrees is one part?", "answer": 20, "unit": "°" },
        { "kind": "numeric", "prompt": "What is the largest angle?", "answer": 160, "unit": "°" }
      ],
      "explanation": "$4 + 5 + 6 + 6 + 7 + 8 = 36$ parts. $720 \\div 36 = 20^\\circ$, so the largest is $8 \\times 20 = 160^\\circ$.",
