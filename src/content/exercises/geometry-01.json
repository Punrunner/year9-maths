    {
      "id": "y1-q2",
      "type": "numeric",
      "prompt": "A polygon has an interior angle sum of $2700^\\circ$. How many sides does it have?",
      "answer": 17,
      "hints": ["$180(n - 2) = 2700$"],
      "explanation": "$n - 2 = 15$, so $n = 17$."
    },
    {
      "id": "y1-q3",
      "type": "numeric",
      "prompt": "A hexagon has angles $38^\\circ$, $170^\\circ$, $118^\\circ$, $103^\\circ$, $165^\\circ$ and $b$. Find $b$.",
      "answer": 126,
      "unit": "°",
      "hints": ["A hexagon's angles add to $720^\\circ$."],
      "explanation": "$38 + 170 + 118 + 103 + 165 = 594$, so $b = 720 - 594 = 126^\\circ$."
    },
    {
      "id": "y1-q4",
      "type": "numeric",
      "prompt": "A pentagon has angles $141^\\circ$, $109^\\circ$, $110^\\circ$, $d$ and $d$. Find $d$.",
      "answer": 90,
      "unit": "°",
      "hints": ["$141 + 109 + 110 + 2d = 540$"],
      "explanation": "$360 + 2d = 540 \\Rightarrow d = 90^\\circ$."
    },
    {
      "id": "y1-q5",
