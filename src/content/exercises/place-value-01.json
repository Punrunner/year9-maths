      "hints": ["$1700 \\times 10^{-2} = 17$.", "$0.03 \\div 10^{-3} = 0.03 \\times 1000$."],
      "explanation": "$17 + 30 = 47$.",
      "difficulty": "challenge"
    },
    {
      "id": "v1-q9",
      "type": "mcq",
      "prompt": "Which card makes this statement true? $\\quad 7 \\times 10^2 = 7 \\div \\square$",
      "options": [
        { "id": "a", "text": "$0.01$" },
        { "id": "b", "text": "$100$" },
        { "id": "c", "text": "$10^{-3}$" },
        { "id": "d", "text": "$0.0001$" }
      ],
      "answer": "a",
      "hints": ["$7 \\times 10^2 = 700$. What do you divide 7 by to get 700?"],
      "explanation": "$7 \\div 0.01 = 7 \\times 100 = 700$, which matches $7 \\times 10^2$. Dividing by 0.01 is the same as multiplying by 100."
    },
    {
      "id": "v1-q10",
      "type": "multi",
      "prompt": "Select **every** calculation that gives an answer **larger** than the starting number.",
      "options": [
        { "id": "a", "text": "$56 \\times 10^{3}$" },
        { "id": "b", "text": "$56 \\times 10^{-3}$" },
        { "id": "c", "text": "$56 \\div 10^{-3}$" },
        { "id": "d", "text": "$56 \\div 10^{3}$" },
        { "id": "e", "text": "$56 \\times 0.01$" },
        { "id": "f", "text": "$56 \\div 0.01$" }
      ],
      "answers": ["a", "c", "f"],
      "hints": ["Dividing by a number less than 1 makes a number bigger."],
      "explanation": "a multiplies by 1000. c and f both divide by something less than 1, which multiplies (by 1000 and by 100). The others all make 56 smaller."
