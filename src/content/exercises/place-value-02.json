        { "id": "b1", "accept": ["1.7"], "size": 5 },
        { "id": "b2", "accept": ["5"], "size": 3 },
        { "id": "c1", "accept": ["4.16"], "size": 5 },
        { "id": "c2", "accept": ["2"], "size": 3 }
      ],
      "hints": ["The front number must be between 1 and 10.", "Count how many places the digits have to move to get back."],
      "explanation": "$6300 = 6.3 \\times 10^3$, $170\\,000 = 1.7 \\times 10^5$, $416 = 4.16 \\times 10^2$.",
      "difficulty": "foundation"
