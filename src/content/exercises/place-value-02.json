      "columns": ["Standard form", "Ordinary number"],
      "rows": [
        [{ "given": "3 × 10⁷" }, { "answer": "30000000", "accept": ["30 000 000"] }],
        [{ "given": "3.81 × 10²" }, { "answer": "381" }],
        [{ "given": "1.628 × 10⁴" }, { "answer": "16280", "accept": ["16 280"] }],
        [{ "given": "6 × 10⁻⁵" }, { "answer": "0.00006" }],
        [{ "given": "4 × 10⁻³" }, { "answer": "0.004" }]
      ],
      "hints": ["Positive power: move the digits left (bigger). Negative power: move them right (smaller)."],
      "explanation": "$3 \\times 10^7 = 30\\,000\\,000$, $3.81 \\times 10^2 = 381$, $1.628 \\times 10^4 = 16\\,280$, $6 \\times 10^{-5} = 0.000\\,06$, $4 \\times 10^{-3} = 0.004$."
    },
    {
      "id": "v2-q5",
      "type": "mcq",
      "prompt": "Emil says: *To write $62 \\times 100\\,000$ in standard form, you write $62 \\times 10^5$.* What is the correct answer?",
      "options": [
        { "id": "a", "text": "$6.2 \\times 10^6$" },
        { "id": "b", "text": "$62 \\times 10^5$ — Emil is right" },
        { "id": "c", "text": "$6.2 \\times 10^4$" },
        { "id": "d", "text": "$0.62 \\times 10^7$" }
      ],
      "answer": "a",
      "hints": ["62 is not between 1 and 10."],
      "explanation": "$62 = 6.2 \\times 10$, so $62 \\times 10^5 = 6.2 \\times 10^6$."
    },
    {
      "id": "v2-q6",
      "type": "order",
      "prompt": "Put these numbers in order, smallest first.",
      "items": [
        { "id": "a", "text": "$4.1 \\times 10^{-3}$" },
        { "id": "b", "text": "$3.2 \\times 10^{-2}$" },
        { "id": "c", "text": "$8.6 \\times 10^{3}$" },
        { "id": "d", "text": "$3.2 \\times 10^{4}$" },
        { "id": "e", "text": "$7.2 \\times 10^{4}$" }
      ],
      "solution": ["a", "b", "c", "d", "e"],
      "hints": ["Compare the powers first. Only if they are equal do you compare the front numbers."],
      "explanation": "$10^{-3} < 10^{-2} < 10^3 < 10^4$. The two with $10^4$ are ordered by their front numbers: $3.2 < 7.2$."
    },
    {
      "id": "v2-q7",
      "type": "fill-blank",
      "prompt": "A factory makes $270\\,000\\,000$ sweets every week. How many is that in a year (52 weeks)? Give your answer in standard form.",
