      "blanks": [
        { "id": "a", "accept": ["1.404"], "size": 6 },
        { "id": "b", "accept": ["10"], "size": 3 }
      ],
      "hints": ["$270\\,000\\,000 \\times 52 = 14\\,040\\,000\\,000$.", "Now write that in standard form."],
      "explanation": "$2.7 \\times 10^8 \\times 52 = 140.4 \\times 10^8 = 1.404 \\times 10^{10}$ sweets."
    },
    {
      "id": "v2-q8",
      "type": "fill-blank",
      "prompt": "The diameter of the Milky Way is about $9.46 \\times 10^{20}$ m. How many **kilometres** is this, in standard form?",
