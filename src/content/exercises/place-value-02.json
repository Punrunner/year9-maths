        { "id": "b2", "accept": ["-4", "−4"], "size": 3 },
        { "id": "c1", "accept": ["2.356"], "size": 5 },
        { "id": "c2", "accept": ["-2", "−2"], "size": 3 }
      ],
      "hints": ["For a number less than 1, the power is negative.", "0.0074 → 7.4 means the digits move 3 places."],
      "explanation": "$0.0074 = 7.4 \\times 10^{-3}$, $0.000\\,13 = 1.3 \\times 10^{-4}$, $0.023\\,56 = 2.356 \\times 10^{-2}$."
    },
    {
      "id": "v2-q3",
