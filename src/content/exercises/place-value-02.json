      "prompt": "Write each small number in standard form.",
      "text": "$0.0074 = $ [[a1]] $\\times 10^{\\square}$ [[a2]] $\\qquad 0.000\\,13 = $ [[b1]] $\\times 10^{\\square}$ [[b2]] $\\qquad 0.023\\,56 = $ [[c1]] $\\times 10^{\\square}$ [[c2]]",
      "blanks": [
        { "id": "a1", "accept": ["7.4"], "size": 5 },
        { "id": "a2", "accept": ["-3", "−3"], "size": 3 },
