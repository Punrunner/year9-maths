      "id": "v2-q1",
      "type": "fill-blank",
      "prompt": "Write each number in standard form.",
      "text": "$6300 = $ [[a1]] $\\times 10^{\\square}$ [[a2]] $\\qquad 170\\,000 = $ [[b1]] $\\times 10^{\\square}$ [[b2]] $\\qquad 416 = $ [[c1]] $\\times 10^{\\square}$ [[c2]]",
      "blanks": [
        { "id": "a1", "accept": ["6.3"], "size": 5 },
