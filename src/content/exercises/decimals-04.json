{
  "title": "Practice: decimal place value, ordering and rounding",
  "intro": "Line up the points, and estimate before you trust an answer.",
  "questions": [
    {
      "id": "d4-q1",
      "type": "mcq",
      "prompt": "What is the value of the digit **7** in $3.172$?",
      "options": [
        { "id": "a", "text": "7 hundredths ($0.07$)" },
        { "id": "b", "text": "7 tenths ($0.7$)" },
        { "id": "c", "text": "7 thousandths ($0.007$)" },
        { "id": "d", "text": "7 ones" }
      ],
      "answer": "a",
      "hints": ["Tenths, hundredths, thousandths — counting from the point."],
      "explanation": "The 7 is the second digit after the point: hundredths. $3.172 = 3 + 0.1 + 0.07 + 0.002$.",
      "difficulty": "foundation"
    },
    {
      "id": "d4-q2",
      "type": "multi",
      "prompt": "Select **every** true statement.",
      "options": [
        { "id": "a", "text": "$0.6 > 0.59$" },
        { "id": "b", "text": "$0.08 > 0.1$" },
        { "id": "c", "text": "$2.5 = 2.50$" },
        { "id": "d", "text": "$0.303 < 0.33$" }
      ],
      "answers": ["a", "c", "d"],
      "hints": ["Give each pair the same number of decimal places."],
      "explanation": "$0.60 > 0.59$ ✓; $0.08 < 0.10$, so the second is false; zeros on the end change nothing ✓; $0.303 < 0.330$ ✓.",
      "difficulty": "foundation"
    },
    {
      "id": "d4-q3",
      "type": "order",
      "prompt": "Put these in order, **largest first**.",
      "items": [
        { "id": "a", "text": "$1.09$" },
        { "id": "b", "text": "$1.9$" },
        { "id": "c", "text": "$1.109$" },
        { "id": "d", "text": "$1.019$" }
      ],
      "solution": ["b", "c", "a", "d"],
      "hints": ["Write them all with 3 decimal places."],
      "explanation": "$1.900 > 1.109 > 1.090 > 1.019$."
    },
    {
      "id": "d4-q4",
      "type": "manipulable",
      "prompt": "Drag the marker to $0.07$.",
      "widget": "number-line",
      "config": { "min": 0, "max": 0.2, "step": 0.01, "majorStep": 0.05, "label": "Marker at", "start": { "x": 0.15 } },
      "target": { "x": 0.07 },
      "tolerance": 0.001,
      "explanation": "$0.07$ is 7 hundredths — a little under halfway to $0.1$ (which is $0.10$).",
      "difficulty": "foundation"
    },
    {
      "id": "d4-q5",
      "type": "numeric",
      "prompt": "Round $6.748$ to 1 decimal place.",
      "answer": 6.7,
      "hints": ["Cut after the first decimal place: $6.7|48$. Look at the next digit."],
      "explanation": "The next digit is 4, so the 7 stays: $6.7$."
    },
    {
      "id": "d4-q6",
      "type": "numeric",
      "prompt": "Round $0.3856$ to 2 decimal places.",
      "answer": 0.39,
      "hints": ["$0.38|56$ — the next digit is 5."],
      "explanation": "The next digit is 5, so round the 8 up: $0.39$."
    },
    {
      "id": "d4-q7",
      "type": "fill-blank",
      "prompt": "Round $9.9962$ to …",
      "text": "1 d.p.: [[a]]     2 d.p.: [[b]]     3 d.p.: [[c]]",
      "blanks": [
        { "id": "a", "accept": ["10.0"], "size": 6 },
        { "id": "b", "accept": ["10.00"], "size": 6 },
        { "id": "c", "accept": ["9.996"], "size": 6 }
      ],
      "hints": ["When a 9 rounds up it becomes 10 and carries — keep the zeros to show the decimal places."],
      "explanation": "$9.9|962 \\to 10.0$; $9.99|62 \\to 10.00$; $9.996|2 \\to 9.996$. The zeros in $10.0$ and $10.00$ show how accurate the answer is.",
      "difficulty": "challenge"
    },
    {
      "id": "d4-q8",
      "type": "numeric",
      "prompt": "Work out $5.8 + 3.47$.",
      "answer": 9.27,
      "hints": ["Write $5.8$ as $5.80$ and line up the points."],
      "explanation": "$5.80 + 3.47 = 9.27$. Estimate: $6 + 3 = 9$ ✓."
    },
    {
      "id": "d4-q9",
      "type": "numeric",
      "prompt": "Work out $20 - 7.35$.",
      "answer": 12.65,
      "hints": ["Write 20 as $20.00$."],
      "explanation": "$20.00 - 7.35 = 12.65$. Check: $12.65 + 7.35 = 20$ ✓."
    },
    {
      "id": "d4-q10",
