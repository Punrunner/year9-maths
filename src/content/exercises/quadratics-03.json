    {
      "id": "u3-q9",
      "type": "mcq",
      "prompt": "Which is the factorisation of $x^2 + 4x - 21$?",
      "options": [
        { "id": "a", "text": "$(x + 7)(x - 3)$" },
        { "id": "b", "text": "$(x - 7)(x + 3)$" },
        { "id": "c", "text": "$(x + 7)(x + 3)$" },
        { "id": "d", "text": "$(x - 7)(x - 3)$" }
