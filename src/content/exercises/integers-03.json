      "prompt": "Simplify this one step at a time.",
      "scenario": "Simplify $\\dfrac{(2^4 \\times 2^{-1})^5}{2^6 \\times 2^5}$ and give the answer as an ordinary number.",
      "steps": [
        {
          "kind": "numeric",
          "prompt": "$2^4 \\times 2^{-1} = 2^{\\square}$. What is the power?",
          "answer": 3,
          "feedback": "$4 + (-1) = 3$."
