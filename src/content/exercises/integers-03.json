        {
          "kind": "numeric",
          "prompt": "$(2^3)^5 = 2^{\\square}$. What is the power?",
          "answer": 15,
          "feedback": "Power of a power: $3 \\times 5 = 15$."
        },
        {
          "kind": "numeric",
          "prompt": "The bottom is $2^6 \\times 2^5 = 2^{\\square}$. What is the power?",
          "answer": 11,
          "feedback": "$6 + 5 = 11$."
        },
        {
          "kind": "numeric",
          "prompt": "So the answer is $2^{15} \\div 2^{11} = 2^4$. What is that as a number?",
          "answer": 16,
          "feedback": "$2^4 = 16$."
        }
      ],
      "explanation": "Top: $(2^{3})^5 = 2^{15}$. Bottom: $2^{11}$. Divide: $2^{15-11} = 2^4 = 16$. Working the brackets and the power first, and the division last, is what keeps this manageable.",
      "difficulty": "challenge"
    },
