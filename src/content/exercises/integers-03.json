        { "id": "p1", "text": "$3^3$" },
        { "id": "p2", "text": "$3^{-2}$" },
        { "id": "p3", "text": "$3^{-1}$" },
        { "id": "p4", "text": "$3^0$" },
        { "id": "p5", "text": "$3^{-4}$" }
      ],
      "right": [
        { "id": "v1", "text": "$27$" },
        { "id": "v2", "text": "$\\frac{1}{9}$" },
        { "id": "v3", "text": "$\\frac{1}{3}$" },
        { "id": "v4", "text": "$1$" },
        { "id": "v5", "text": "$\\frac{1}{81}$" }
      ],
      "solution": { "p1": "v1", "p2": "v2", "p3": "v3", "p4": "v4", "p5": "v5" },
      "hints": ["$3^4 = 81$."],
      "explanation": "$3^3 = 27$. The negative powers are reciprocals: $3^{-1} = \\frac{1}{3}$, $3^{-2} = \\frac{1}{9}$, $3^{-4} = \\frac{1}{81}$. And $3^0 = 1$."
    },
    {
      "id": "i3-q5",
