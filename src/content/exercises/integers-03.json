    {
      "id": "i3-q6",
      "type": "multi",
      "prompt": "Select **every** statement that is true.",
      "options": [
        { "id": "a", "text": "$5^0 > 2^0$" },
        { "id": "b", "text": "$2^{-3} > 2^{-2}$" },
        { "id": "c", "text": "$6^{-3} < 0$" },
        { "id": "d", "text": "$(-2)^{-1} < 0.5$" },
        { "id": "e", "text": "$0 > -3^{2}$" }
