    {
      "id": "q1",
      "calculator": "either",
      "difficulty": "core",
      "stem": "The table shows the masses, $m$ kg, of 40 parcels.$$\\begin{array}{c|c} \\text{Mass } (m \\text{ kg}) & \\text{Frequency} \\\\ \\hline 0 < m \\le 2 & 4 \\\\ 2 < m \\le 4 & 15 \\\\ 4 < m \\le 6 & 12 \\\\ 6 < m \\le 8 & 9 \\end{array}$$",
      "parts": [
        {
          "label": "a",
          "prompt": "Write down the modal class.",
          "marks": 1,
          "answer": "$2 < m \\le 4$",
          "check": {
            "kind": "text",
            "accept": [
              "2<m<=4",
              "2<m≤4",
              "2-4",
              "2 to 4"
            ]
          }
        },
        {
          "label": "b",
          "prompt": "Write down the class that contains the median.",
          "marks": 1,
          "answer": "$4 < m \\le 6$",
          "check": {
            "kind": "text",
            "accept": [
              "4<m<=6",
              "4<m≤6",
              "4-6",
              "4 to 6"
            ]
          }
        },
        {
          "label": "c",
          "prompt": "Calculate an estimate of the mean mass.",
          "marks": 4,
          "answer": "4.3",
          "partial": [
            "M1 for midpoints 1, 3, 5, 7 soi",
            "M1 for $\\sum fx$ with $x$ in the correct interval including both boundaries",
            "M1 (dep on second M1) for $\\div 40$"
          ],
          "check": {
            "kind": "numeric",
            "answer": 4.3
          },
          "answerSuffix": "kg"
        },
        {
          "label": "d",
          "prompt": "Explain why your answer to part (c) is only an estimate.",
          "marks": 1,
          "answer": "The exact masses are not known — the midpoint is used for each class",
          "partial": [
            "B1"
          ]
        }
      ],
      "needsReview": true
    },
