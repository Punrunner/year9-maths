---
/** Exam practice: a Cambridge-style written paper built from across the course,
 *  plus the list of set tests from src/content/tests/. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ExamPaper from '../components/exercises/ExamPaper.tsx';
import { getTopicNodes, getCatalog } from '../lib/site';
import { prepareExamQuestion } from '../lib/exam';

const nodes = await getTopicNodes();
const catalog = await getCatalog();
const banks = await getCollection('exam');

// One pool of structured questions, in course order, tagged with their topic.
const questions = nodes.flatMap((n) => {
  const bank = banks.find((b) => b.data.topic.id === n.topic.id);
  if (!bank) return [];
  return bank.data.questions.map((q) => prepareExamQuestion(q, n.topic.id, n.topic.data.title));
});

// Set tests, by their `order`; tests without one go last, by file name.
const tests = (await getCollection('tests'))
  .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity) || a.id.localeCompare(b.id))
  .map((t) => ({
    href: `/test/${t.id}/`,
    title: t.data.title,
    candidate: t.data.candidate,
    date: t.data.date,
    minutes: t.data.minutes,
    calculator: t.data.calculator,
    marks: t.data.questions
      .flatMap((q) => q.parts.flatMap((p) => ('parts' in p ? p.parts : [p])))
      .reduce((n, l) => n + l.marks, 0),
    sections: [...new Set(t.data.questions.map((q) => q.section).filter(Boolean))],
  }));
---

<Base title="Exam practice" description="Build a Cambridge-style practice paper, with a full mark scheme, from across the whole Year 9 course.">
  <div class="container page page-narrow">
    <Breadcrumbs items={[{ label: 'Exam practice' }]} />

    <header class="page-head no-print">
      <p class="page-eyebrow">Revision</p>
      <h1>Exam practice</h1>
      <p class="page-lead">
        A written paper in the Cambridge style, drawn from every topic you have
        worked through — then mark it yourself against a real mark scheme.
      </p>
    </header>

    {tests.length > 0 && (
      <section class="test-list no-print" aria-labelledby="tests-heading">
        <h2 id="tests-heading">Tests</h2>
        <ul>
          {tests.map((t) => (
            <li>
              <a class="test-card card card-link" href={t.href}>
                <span class="test-card-title">{t.title}</span>
                <span class="test-card-meta">
                  {[t.candidate, t.date, `${t.marks} marks`, `${t.minutes} min`,
                    t.calculator === 'calculator' ? 'Calculator' : 'Non-calculator']
                    .filter(Boolean).join(' · ')}
                </span>
                {t.sections.length > 0 && <span class="test-card-sections">{t.sections.join(', ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <ExamPaper client:load questions={questions} catalog={catalog} />
  </div>
</Base>
