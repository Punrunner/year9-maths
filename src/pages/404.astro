---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="container page page-narrow not-found">
    <p class="page-eyebrow">Error 404</p>
    <h1>That page does not exist</h1>
    <p class="page-lead">
      The link may be out of date. Try starting from the home page, or search for
      the topic you were after.
    </p>
    <p><a class="btn btn-primary" href="/">Back to the home page</a></p>
  </div>
</Base>
